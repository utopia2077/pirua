{
  "name": "@pirua/pi-tui-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pirua-tui": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:extraction": "node scripts/check-extraction.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "1.4.0",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "6.0.0",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.3",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "minimatch": "10.2.6",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/hosted-git-info": "3.0.5"
  }
}
