{
  "schemaVersion": 1,
  "classification": "independently authored controller/native contract; deliberately not executed as upstream expected successes",
  "cases": [
    {
      "id": "native-allocation-only-reopen-no-reuse",
      "basis": {
        "kind": "controller-native-contract",
        "source": "native Session contract no ID reuse across reopen; tagged spec storage allocator intent"
      },
      "relatedObservedCase": "sqlite-allocation-only-reopen-variance",
      "input": {
        "operations": [
          {
            "op": "mint",
            "count": 2
          },
          {
            "op": "reopen"
          },
          {
            "op": "mint",
            "count": 2
          }
        ]
      },
      "expected": {
        "mintedBefore": [
          2,
          3
        ],
        "mintedAfter": [
          4,
          5
        ]
      },
      "distinction": "Released SQLite returns [2,3] after reopen when allocation has no intervening commit; native reservation must be durable."
    },
    {
